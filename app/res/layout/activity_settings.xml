<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="34dp"
        android:paddingTop="20dp"
        android:paddingRight="34dp"
        android:paddingBottom="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="SETTINGS"
            android:textColor="#FFFFFF"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.22"
            android:text="WEATHER CITY"
            android:textColor="@color/green_soft"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/cityRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/btnCitySearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:background="@drawable/card_bg_sm"
            android:clickable="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingTop="12dp"
            android:paddingEnd="18dp"
            android:paddingBottom="12dp"
            android:text="Search any city worldwide"
            android:textColor="@color/green"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:letterSpacing="0.22"
            android:text="TILE SIZE"
            android:textColor="@color/green_soft"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/sizeRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:letterSpacing="0.22"
            android:text="CORNERS"
            android:textColor="@color/green_soft"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/cornerRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:letterSpacing="0.22"
            android:text="BACKGROUND DIMMER"
            android:textColor="@color/green_soft"
            android:textSize="11sp" />

        <FrameLayout
            android:id="@+id/dimPreview"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg_sm">

            <ImageView
                android:id="@+id/dimPreviewWall"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />

            <View
                android:id="@+id/dimPreviewScrim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#000000" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/dimRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:letterSpacing="0.22"
            android:text="NETWORK"
            android:textColor="@color/green_soft"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/netStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Checking…"
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:letterSpacing="0.22"
            android:text="ACTIONS"
            android:textColor="@color/green_soft"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnRefresh"
                android:layout_width="216dp"
                android:layout_height="52dp"
                android:background="@drawable/card_bg_sm"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:text="Refresh weather now"
                android:textColor="@color/text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnWallpaper"
                android:layout_width="216dp"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/card_bg_sm"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:text="Change wallpaper"
                android:textColor="@color/text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnSystemSettings"
                android:layout_width="216dp"
                android:layout_height="52dp"
                android:layout_marginStart="12dp"
                android:background="@drawable/card_bg_sm"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="center"
                android:text="System settings"
                android:textColor="@color/text"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:letterSpacing="0.22"
            android:text="ABOUT"
            android:textColor="@color/green_soft"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/muted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
