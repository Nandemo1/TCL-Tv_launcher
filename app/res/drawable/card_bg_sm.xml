<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="14dp" />
                    <solid android:color="#00000000" />
                    <stroke android:width="5dp" android:color="#3D00E676" />
                </shape>
            </item>
            <item android:left="3dp" android:top="3dp" android:right="3dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="11dp" />
                    <gradient
                        android:angle="315"
                        android:startColor="#46FFFFFF"
                        android:endColor="#1FFFFFFF" />
                    <stroke android:width="2dp" android:color="@color/green" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="11dp" />
            <gradient
                android:angle="315"
                android:startColor="#33FFFFFF"
                android:endColor="#0FFFFFFF" />
            <stroke android:width="1dp" android:color="#26FFFFFF" />
        </shape>
    </item>
</selector>
